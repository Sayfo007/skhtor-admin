rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "ahmadseifaldin@gmail.com";
    }
    match /menu/{d}   { allow read: if true; allow write: if isAdmin(); }
    match /config/{d} { allow read: if true; allow write: if isAdmin(); }
    match /adminTokens/{t} { allow read, write: if isAdmin(); }
    match /orders/{id} {
      allow get: if true;
      allow list, update, delete: if isAdmin();
      allow create: if get(/databases/$(database)/documents/config/presence).data.open == true
        && request.resource.data.status == "New"
        && request.resource.data.keys().hasOnly(['no','mode','name','phone','addr','pin','floor','apt','code','atype','when','note','lines','total','status','ts','uid','fcm','lang','acct','sub','deliv','km'])
        && request.resource.data.lines.size() <= 80;
    }
  }
}
